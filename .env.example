# 값은 이 파일에 쓰지 않는다. `.env`(커밋되지 않음)에 복사해서 채운다.
# 환경 변수가 `.env`보다 우선한다.

# 로그인을 허용할 GitHub 숫자 ID. 쉼표로 구분 (예: 1234,5678)
PROFESSOR_GITHUB_IDS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 인증 코드 계산에 쓰는 비밀값. 길고 무작위인 문자열
SERVER_SECRET=

# 서비스 주소. Origin 검사와 OAuth 콜백에 쓴다
BASE_URL=

# 메일 발송(Resend). 개발과 테스트는 OutboxMailer를 쓰므로 비워 둬도 된다
RESEND_API_KEY=
MAIL_FROM=
MAIL_RATE_PER_SEC=

# 비워 두면 기본값을 쓴다
DATABASE_PATH=
CLIENT_DIST=
