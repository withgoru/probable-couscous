# 값은 이 파일에 쓰지 않는다. `.env`(커밋되지 않음)에 복사해서 채운다.
# 환경 변수가 `.env`보다 우선한다.

# 로그인을 허용할 GitHub 숫자 ID. 쉼표로 구분 (예: 1234,5678)
PROFESSOR_GITHUB_IDS=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 인증 코드 계산에 쓰는 비밀값. 길고 무작위인 문자열
SERVER_SECRET=

# 서비스 주소. 브라우저가 접속하는 주소와 같아야 한다(Origin 검사와 OAuth 콜백에 쓴다).
# 개발 중에 client를 npm run dev로 띄우면 http://localhost:5173, 서버가 직접 내려주면 http://localhost:8000.
# GitHub OAuth 앱의 Authorization callback URL은 이 주소 뒤에 /api/auth/github/callback을 붙인 것이다.
BASE_URL=

# 메일 발송(Resend). 비워 두면 메일을 보내지 않고 메모리에만 모은다(개발·테스트. 학생은 '교수님께 알리기'로 입장).
# RESEND_API_KEY를 넣으면 MAIL_FROM도 꼭 넣는다. Resend에서 인증한 도메인의 주소여야 한다. 예: 강의 도구 <no-reply@인증한도메인>
# 키는 이 파일(.env)이나 환경 변수에만 둔다. 저장소에 커밋하지 않는다.
RESEND_API_KEY=
MAIL_FROM=
# 초당 보내는 메일 수. Resend 기본 상한(팀당 초당 10건)보다 낮게 둔다. 비우면 8
MAIL_RATE_PER_SEC=

# 비워 두면 기본값을 쓴다
DATABASE_PATH=
CLIENT_DIST=
