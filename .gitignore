# --- Secrets (never commit; commit only .env.example) ---
.env
.env.*
!.env.example

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- Claude Code local state ---
.claude/settings.local.json
.claude/worktrees/

# --- Python (server/: FastAPI, pytest, ruff) ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- SQLite data (WAL and shm files included) ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-shm
*.sqlite-wal
server/data/

# --- Node (client/: SvelteKit, Tailwind, Vitest, Playwright; Slidev builds) ---
node_modules/
.svelte-kit/
.vite/
.slidev/
client/build/
client/dist/
dist/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache

# --- Playwright ---
test-results/
playwright-report/
blob-report/
playwright/.cache/

# --- Logs and temp ---
*.log
tmp/

# --- 슬라이드 템플릿(002) ---
slides-template/.build/
slides-template/*.zip

# --- uv (server/ uses pip + constraints.txt; uv.lock is a local by-product) ---
server/uv.lock
